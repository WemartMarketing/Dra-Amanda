# Pacote de publicação gerado localmente para envio à HostGator
/wemart-sales-deploy.zip

# Credenciais reais de banco de dados — cada ambiente (dev, produção)
# cria o seu a partir de includes/config.example.php, nunca commitado.
/includes/config.php

# Imagens enviadas pelos usuários (ficam só no servidor; a pasta e o
# .htaccess de proteção são versionados)
/uploads/empreendimentos/*
!/uploads/empreendimentos/.gitkeep

# Documentos de leads (privados, só no servidor; a pasta e o .htaccess
# que bloqueia o acesso direto são versionados)
/storage/lead_arquivos/*
!/storage/lead_arquivos/.gitkeep

# Backups do banco (cron/backup.php) e temporários de importação: só no servidor
/storage/backups/
/storage/importacoes/
